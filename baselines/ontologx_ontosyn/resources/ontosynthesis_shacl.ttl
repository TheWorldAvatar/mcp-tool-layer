  sh:property [
    sh:path ontosyn:referencesMaterial ;
    sh:class <http://www.theworldavatar.com/ontology/ontocape/material/material.owl#Material> ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontosyn:hasAmount ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ontosyn:hasPurity ;
