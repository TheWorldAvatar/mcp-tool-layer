@prefix ontospecies: <http://www.theworldavatar.com/ontology/ontospecies/OntoSpecies.owl#> .
@prefix periodic: <http://www.daml.org/2003/01/periodictable/PeriodicTable#> .
@prefix ontosyn: <https://www.theworldavatar.com/kg/OntoSyn/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# OntoSpecies SHACL for OntoLogX extension (inherit OntoSyn main graph).
# Generated from data/ontologies/ontospecies-subgraph.ttl.
# closedByTypes is omitted so a ChemicalOutput may also be a Species.

periodic:ElementShape a sh:NodeShape ;
  sh:targetClass periodic:Element ;
  sh:property [
    sh:path ontospecies:hasAtomicWeight ;
    sh:class ontospecies:AtomicWeight ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasElementName ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ontospecies:hasElementSymbol ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:AtomicWeightShape a sh:NodeShape ;
  sh:targetClass ontospecies:AtomicWeight ;
  sh:property [
    sh:path ontospecies:hasAtomicWeightValue ;
    sh:or ( [ sh:datatype xsd:float ] [ sh:datatype xsd:double ] ) ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:CCDCNumberShape a sh:NodeShape ;
  sh:targetClass ontospecies:CCDCNumber ;
  sh:property [
    sh:path ontospecies:hasCCDCNumberValue ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:CharacterizationSessionShape a sh:NodeShape ;
  sh:targetClass ontospecies:CharacterizationSession ;
  sh:property [
    sh:path ontospecies:usesDevice ;
    sh:class ontospecies:Device ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasHNMRDevice ;
    sh:class ontospecies:HNMRDevice ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasElementalAnalysisDevice ;
    sh:class ontospecies:ElementalAnalysisDevice ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasInfraredSpectroscopyDevice ;
    sh:class ontospecies:InfraredSpectroscopyDevice ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:ChemicalFormulaShape a sh:NodeShape ;
  sh:targetClass ontospecies:ChemicalFormula ;
  sh:property [
    sh:path ontospecies:hasChemicalFormulaValue ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:ChemicalShiftShape a sh:NodeShape ;
  sh:targetClass ontospecies:ChemicalShift ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:DeviceShape a sh:NodeShape ;
