  ] .

ontospecies:MolecularFormulaShape a sh:NodeShape ;
  sh:targetClass ontospecies:MolecularFormula ;
  sh:property [
    sh:path ontospecies:hasMolecularFormulaValue ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
