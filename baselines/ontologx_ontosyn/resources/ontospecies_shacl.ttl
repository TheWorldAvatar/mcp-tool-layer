  ] .

ontospecies:InfraredSpectroscopyDeviceShape a sh:NodeShape ;
  sh:targetClass ontospecies:InfraredSpectroscopyDevice ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:MaterialShape a sh:NodeShape ;
  sh:targetClass ontospecies:Material ;
  sh:property [
    sh:path ontospecies:hasMaterialName ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1
