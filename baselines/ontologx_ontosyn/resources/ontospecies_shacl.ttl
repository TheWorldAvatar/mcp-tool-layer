ontospecies:SolventShape a sh:NodeShape ;
  sh:targetClass ontospecies:Solvent ;
  sh:property [
    sh:path ontospecies:hasSolventName ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path rdfs:label ;
    sh:datatype xsd:string
  ] .

ontospecies:SpeciesShape a sh:NodeShape ;
  sh:targetClass ontospecies:Species ;
  sh:property [
    sh:path ontospecies:hasCharacterizationSession ;
    sh:class ontospecies:CharacterizationSession ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ontospecies:hasHNMRData ;
    sh:class ontospecies:HNMRData ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasElementalAnalysisData ;
    sh:class ontospecies:ElementalAnalysisData ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasInfraredSpectroscopyData ;
    sh:class ontospecies:InfraredSpectroscopyData ;
    sh:nodeKind sh:IRI
  ] ;
  sh:property [
    sh:path ontospecies:hasMolecularFormula ;
    sh:class ontospecies:MolecularFormula ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ontospecies:hasChemicalFormula ;
    sh:class ontospecies:ChemicalFormula ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ontospecies:hasCCDCNumber ;
    sh:class ontospecies:CCDCNumber ;
    sh:nodeKind sh:IRI ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ontospecies:hasProductName ;
    sh:datatype xsd:string ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
