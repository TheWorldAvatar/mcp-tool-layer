{
  "ontologies": {
    "main": {
      "name": "ontosynthesis",
      "description": "The ontology for the synthesis of chemical compounds.",
      "ttl_file": "data/ontologies/ontosynthesis.ttl",
      "complex_pipeline": true,
      "agent_model": "gpt-4o",
      "runtime_policies": {
        "iter1_top_entity_kg": {
          "global_state_entity_name": "top",
          "prompt_rules": {
            "doi_argument_source": "current_document_hash",
            "top_level_entity_name": "ChemicalSynthesis",
            "forbid_human_readable_label_as_doi": true
          }
        },
        "main_entity_kg": {
          "runtime_context": {
            "lock_to_global_state_entity_name": true
          },
          "publish": {
            "merge_top_ttl_into_entity_ttl": true,
            "top_entity_context_name": "top",
            "prefer_composite_intermediate": true,
            "hint_reconciliation": {
              "ordered_member_hint_contracts": [
                {
                  "section_name": "SynthesisStepList",
                  "type_namespace_iri": "https://www.theworldavatar.com/kg/OntoSyn/",
                  "type_keys": [
                    "rdf:type",
                    "type"
                  ],
                  "order_keys": [
                    "ontosyn:hasOrder",
                    "hasOrder"
                  ],
                  "order_predicate_iri": "https://www.theworldavatar.com/kg/OntoSyn/hasOrder"
                }
              ]
            }
          },
          "shell_validation": {
            "top_entity_class_iri": "https://www.theworldavatar.com/kg/OntoSyn/ChemicalSynthesis",
            "require_entity_uri_subject": true,
            "required_links": [
              {
                "predicate_iri": "https://www.theworldavatar.com/kg/OntoSyn/hasSynthesisStep",
                "target_class_iri": "https://www.theworldavatar.com/kg/OntoSyn/SynthesisStep",
                "min_count": 1,
                "ordered_member": true
              },
              {
                "predicate_iri": "https://www.theworldavatar.com/kg/OntoSyn/hasChemicalOutput",
                "target_class_iri": "https://www.theworldavatar.com/kg/OntoSyn/ChemicalOutput",
                "min_count": 1,
                "placeholder_target_if_missing": {
                  "derive_label_from_top_entity": true
                }
              }
            ]
          },
          "prompt_rules": {
            "require_top_entity_reuse": true,
            "forbid_new_top_entity_creation": true,
            "require_required_links_before_export": true
          },
          "max_attempts": 1,
          "semantic_audit": {
            "nonblocking_after_semantic_exhaustion": true
          },
          "presence_coverage_audit": {
            "enabled": true,
            "replace_llm_audits": true,
            "model": "gpt-4o",
            "mcp_groups": []
          },
          "post_publish_warnings": {
            "typed_nodes_missing_predicate": [
              {
                "subject_class_iri": "https://www.theworldavatar.com/kg/OntoSyn/Add",
                "predicate_iri": "https://www.theworldavatar.com/kg/OntoSyn/hasAddedChemicalInput",
                "order_predicate_iri": "https://www.theworldavatar.com/kg/OntoSyn/hasOrder",
                "message": "Add step has no configured added-input predicate"
              }
            ]
          }
        },
        "top_entity_extraction": {
          "invalidate_top_entities_txt_substrings": [
            "No ChemicalSynthesis",
            "ChemicalSynthesis instances",
            "ontosyn:ChemicalSynthesis"
          ],
          "count_lines_starting_with": [
            "ChemicalSynthesis"
          ],
          "identifier_code_regex": "\\b[A-Z][A-Z0-9]{1,}(?:[-_]\\d+[A-Za-z0-9]*)\\b"
        },
        "iteration_plan": {
          "iterations_blueprint_path": "configs/meta_task/ontosynthesis_iterations_blueprint.json",
          "postprocess_overrides": {
            "2": {
              "name": "inputs_outputs",
              "model_config_key": "iter2_hints",
              "use_agent": true,
              "inputs": {
                "keep_only": [
                  "source"
                ],
                "set": {
                  "source": "stitched_paper"
                }
              }
            },
            "3": {
              "name": "synthesis_steps",
              "model_config_key": "iter3_hints",
              "use_agent": false,
              "inputs": {
                "keep_only": [
                  "pre_extraction_source",
                  "extraction_source"
                ],
                "set": {
                  "pre_extraction_source": "stitched_paper",
                  "extraction_source": "pre_extracted_text"
                }
              }
            },
            "4": {
              "name": "yield_extraction",
              "model_config_key": "iter4_hints",
              "use_agent": false
            }
          }
        }
      },
      "output": {
        "dir": "{ontology_name}_output",
        "top_ttl_name": "top.ttl",
        "entity_ttl_pattern": "{entity_safe}.ttl"
      },
      "mcp_set_name": "run_created_mcp.json",
      "mcp_list": [
        "llm_created_mcp"
      ]
    },
    "extensions": [
      {
        "name": "ontomops",
        "description": "The ontology for describing of metal-organic polyhedra.",
        "ttl_file": "data/ontologies/ontomops-subgraph.ttl",
        "complex_pipeline": false,
        "runtime_policies": {
          "enrichment_target": {
            "query_file": "configs/sparql/extensions/ontomops_enrichment_target.sparql",
            "target_variable": "target",
            "target_class_iri": "https://www.theworldavatar.com/kg/ontomops/MetalOrganicPolyhedron",
            "cardinality": "exactly_one"
          }
        },
        "output": {
          "dir": "{ontology_name}_output",
          "entity_ttl_pattern": "{ontology_name}_extension_{entity_name}.ttl"
        },
        "mcp_set_name": "extension.json",
        "mcp_list": [
          "mops_extension",
          "ccdc"
        ],
        "agent_model": "gpt-4o"
      },
      {
        "name": "ontospecies",
        "description": "The ontology for describing the species of chemical compounds.",
        "ttl_file": "data/ontologies/ontospecies-subgraph.ttl",
        "complex_pipeline": false,
        "runtime_policies": {
          "enrichment_target": {
            "query_file": "configs/sparql/extensions/ontospecies_enrichment_target.sparql",
            "target_variable": "target",
            "target_class_iri": "http://www.theworldavatar.com/ontology/ontospecies/OntoSpecies.owl#Species",
            "cardinality": "exactly_one"
          }
        },
        "output": {
          "dir": "{ontology_name}_output",
          "entity_ttl_pattern": "{entity_slugified}.ttl"
        },
        "mcp_set_name": "extension.json",
        "mcp_list": [
          "ontospecies_extension",
          "ccdc"
        ],
        "agent_model": "gpt-4o"
      }
    ]
  }
}
