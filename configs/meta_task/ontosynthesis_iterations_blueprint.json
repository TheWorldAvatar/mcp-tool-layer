{
  "ontology": "ontosynthesis",
  "description": "The ontology for the synthesis of chemical compounds.",
  "iterations": [
    {
      "iteration_number": 2,
      "name": "inputs_outputs",
      "description": "Extract ChemicalInput and ChemicalOutput instances for each ChemicalSynthesis, establish source-document provenance through retrievedFrom to the DOI-identified Document, and capture a distinct in-document structural anchor as DocumentContext when a section, subsection, or paragraph label for this synthesis is identifiable in the source.",
      "responsibilities": {
        "classes": [
          "ChemicalInput",
          "ChemicalOutput",
          "Document",
          "DocumentContext"
        ],
        "object_properties": [
          "hasChemicalInput",
          "hasChemicalOutput",
          "retrievedFrom",
          "hasDocumentContext"
        ],
        "required_materialization": [
          "For the current ChemicalSynthesis, create or reuse the DOI-identified Document and satisfy the T-Box-required retrievedFrom link.",
          "When the source contains a distinct section title, subsection heading, paragraph label, or paragraph number that anchors the current ChemicalSynthesis, create or reuse exactly one DocumentContext using that anchor verbatim and link it through hasDocumentContext. Omit DocumentContext when no distinct anchor is identifiable. DocumentContext is an in-document structural anchor and must never be substituted for the DOI-identified Document used by retrievedFrom."
        ]
      },
      "extraction_prompt": "ai_generated_contents/prompts/ontosynthesis/EXTRACTION_ITER_2.md",
      "model_config_key": "iter2_hints",
      "per_entity": true,
      "use_agent": true,
      "inputs": {
        "source": "stitched_paper"
      },
      "outputs": {
        "hints_file": "mcp_run/iter2_hints_{entity_safe}.txt",
        "prompt_file": "prompts/iter2_extraction/{entity_safe}.md",
        "response_file": "responses/iter2_extraction/{entity_safe}.md"
      },
      "mcp_set_name": "run_created_mcp.json",
      "mcp_tools": [
        "llm_created_mcp"
      ],
      "kg_building_prompt": "ai_generated_contents/prompts/ontosynthesis/KG_BUILDING_ITER_2.md",
      "extraction_mcp_set_name": "chemistry.json",
      "extraction_mcp_tools": [
        "pubchem",
        "enhanced_websearch",
        "ccdc"
      ],
      "extraction_validation": {
        "required_executed_tool_groups": [
          {
            "name": "chemical_identity_lookup",
            "any_of": [
              "search_pubchem_by_name",
              "search_pubchem_by_smiles",
              "search_pubchem_advanced",
              "get_pubchem_compound_by_cid"
            ]
          }
        ]
      }
    },
    {
      "iteration_number": 3,
      "name": "synthesis_steps",
      "description": "Extract SynthesisStep instances for each ChemicalSynthesis, including step order and type.",
      "responsibilities": {
        "classes": [
          "Add",
          "Stir",
          "HeatChill",
          "Evaporate",
          "Sonicate",
          "Transfer",
          "Separate",
          "Filter",
          "Dry",
          "Crystallize",
          "Vessel",
          "VesselType",
          "VesselEnvironment",
          "Equipment",
          "HeatChillDevice",
          "SeparationType"
        ],
        "object_properties": [
          "hasSynthesisStep",
          "hasAddedChemicalInput",
          "hasVessel",
          "hasVesselEnvironment",
          "hasVesselType",
          "usesEquipment",
          "hasHeatChillDevice",
          "hasStirringTemperature",
          "hasTargetTemperature",
          "hasTemperatureRate",
          "hasEvaporationTemperature",
          "hasEvaporationPressure",
          "isEvaporatedToVolume",
          "removesSpecies",
          "hasDryingAgent",
          "hasDryingTemperature",
          "hasDryingPressure",
          "hasSeparationSolvent",
          "isSeparationType",
          "hasTransferedAmount",
          "isTransferedTo",
          "hasWashingSolvent",
          "hasStepDuration"
        ]
      },
      "has_pre_extraction": true,
      "pre_extraction_prompt": "ai_generated_contents/prompts/ontosynthesis/PRE_EXTRACTION_ITER_3.md",
      "pre_extraction_model_key": "advanced_model",
      "pre_extraction_validation": {
        "closed_ledger": {
          "enabled": true
        }
      },
      "extraction_prompt": "ai_generated_contents/prompts/ontosynthesis/EXTRACTION_ITER_3.md",
      "model_config_key": "iter3_hints",
      "hint_representation": "semantic-text.v1",
      "linked_materialization_classes": [
        "ChemicalInput"
      ],
      "per_entity": true,
      "use_agent": true,
      "extraction_mcp_set_name": "chemistry.json",
      "extraction_mcp_tools": [
        "pubchem",
        "enhanced_websearch",
        "ccdc"
      ],
      "extraction_validation": {
        "required_executed_tool_groups": [
          {
            "name": "chemical_identity_lookup",
            "any_of": [
              "search_pubchem_by_name",
              "search_pubchem_by_smiles",
              "search_pubchem_advanced",
              "get_pubchem_compound_by_cid"
            ]
          }
        ],
        "forbid_generic_ordered_member_types": {
          "enabled": true,
          "generic_labels": [
            "SynthesisStep",
            "Step",
            "Operation",
            "Procedure",
            "Workup"
          ],
          "generic_key_patterns": [
            "^SynthesisStep\\s*\\d+$"
          ],
          "type_keys": [
            "rdf:type",
            "type",
            "class",
            "step_type",
            "steptype"
          ]
        }
      },
      "require_members_when_source_matches": [
        {
          "enabled": true,
          "section_name": "SynthesisStepList",
          "source_patterns": [
            "\\bheated\\b[^.\\n;]*\\b\\d+(?:\\.\\d+)?\\s*(?:°\\s*C|℃|degrees?\\s*C|C)\\b[^.\\n;]*\\b\\d+(?:\\.\\d+)?\\s*(?:h|hr|hrs|hour|hours)\\b"
          ],
          "expected_type": "ontosyn:HeatChill",
          "required_properties": [
            "ontosyn:hasTargetTemperature",
            "ontosyn:hasStepDuration"
          ]
        }
      ],
      "inputs": {
        "pre_extraction_source": "stitched_paper",
        "extraction_source": "pre_extracted_text"
      },
      "outputs": {
        "hints_file": "mcp_run/iter3_hints_{entity_safe}.txt",
        "prompt_file": "prompts/iter3_extraction/{entity_safe}.md",
        "response_file": "responses/iter3_extraction/{entity_safe}.md",
        "pre_extraction_file": "pre_extraction/entity_text_{entity_safe}.txt",
        "pre_extraction_prompt_file": "prompts/iter3_pre_extraction/{entity_safe}.md",
        "pre_extraction_response_file": "responses/iter3_pre_extraction/{entity_safe}.md"
      },
      "mcp_set_name": "run_created_mcp.json",
      "mcp_tools": [
        "llm_created_mcp"
      ],
      "kg_building_prompt": "ai_generated_contents/prompts/ontosynthesis/KG_BUILDING_ITER_3.md"
    },
    {
      "iteration_number": 4,
      "name": "yield_extraction",
      "description": "Extract yield information for each ChemicalSynthesis.",
      "responsibilities": {
        "classes": [
          "ExecutionPoint"
        ],
        "object_properties": [
          "hasYield",
          "hasEquipment"
        ]
      },
      "extraction_prompt": "ai_generated_contents/prompts/ontosynthesis/EXTRACTION_ITER_4.md",
      "model_config_key": "iter4_hints",
      "per_entity": true,
      "use_agent": false,
      "inputs": {
        "file_path": "extracted_data/{entity_safe}/synthesis_steps_enriched.json",
        "source": "stitched_paper"
      },
      "outputs": {
        "hints_file": "mcp_run/iter4_hints_{entity_safe}.txt",
        "prompt_file": "prompts/iter4_extraction/{entity_safe}.md",
        "response_file": "responses/iter4_extraction/{entity_safe}.md"
      },
      "mcp_set_name": "run_created_mcp.json",
      "mcp_tools": [
        "llm_created_mcp"
      ],
      "kg_building_prompt": "ai_generated_contents/prompts/ontosynthesis/KG_BUILDING_ITER_4.md"
    }
  ]
}
