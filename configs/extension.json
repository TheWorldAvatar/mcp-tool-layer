      "-m",
      "ai_generated_contents_pipeline_bundle.scripts.ontomops.main"
    ],
    "env": {
      "TWA_AGENTIC_DATA_DIR": "${TWA_AGENTIC_DATA_DIR}"
    },
    "transport": "stdio"
  },
  "ontospecies_extension": {
    "command": "python",
    "args": [
      "-m",
      "ai_generated_contents_pipeline_bundle.scripts.ontospecies.main"
    ],
    "env": {
      "TWA_AGENTIC_DATA_DIR": "${TWA_AGENTIC_DATA_DIR}"
    },
    "transport": "stdio"
  },
  "ccdc": {
    "command": "python",
    "args": [
      "-m",
      "src.mcp_servers.ccdc.main"
    ],
    "transport": "stdio"
  }
}
