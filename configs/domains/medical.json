{
  "schema_version": "domain-generation-config.v1",
  "domain_id": "medical",
  "ontology_name": "medical",
  "execution_profile": "simple_main",
  "workflow_profile": "simple",
  "tbox": {
    "primary": "medical_case/medical_case_schema_de_non_flat_v4.ttl",
    "supporting": []
  },
  "models": {
    "top_entity_planning": "gpt-5",
    "iteration_planning": "gpt-5",
    "script_generation": "gpt-5",
    "prompt_generation": "gpt-5",
    "semantic_review": "gpt-5",
    "repair": "gpt-5",
    "runtime_extraction": "gpt-5",
    "runtime_kg_building": "gpt-5",
    "semantic_scoring": "gpt-5"
  },
  "mcp_capabilities": {
    "kg_building": {
      "set_name": "generated_ontology_mcps.json",
      "tools": [
        "medical_mcp"
      ]
    }
  },
  "runtime": {
    "binding": {
      "role": "main"
    },
    "output": {
      "dir": "medical_output",
      "top_ttl_name": "top.ttl",
      "entity_ttl_pattern": "{entity_safe}.ttl"
    },
    "workflow": {
      "iterations": [
        {
          "use_agent": false,
          "inputs": {
            "source": "stitched_paper"
          },
          "enrichment": []
        }
      ]
    }
  },
  "agents": {
    "top_entity_extraction": true,
    "iteration_extraction": true,
    "external_enrichment": false,
    "kg_building": true,
    "prompt_repair": true,
    "semantic_adjudication": true
  }
}
