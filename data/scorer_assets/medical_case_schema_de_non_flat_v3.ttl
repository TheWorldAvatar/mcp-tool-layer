@prefix med: <https://www.theworldavatar.com/kg/medical/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# OP- und Verlaufserfassung (Testcase 1) – Ontologie (DE)
# NON-FLAT VERSION (v3) – ENHANCED
# Erweitert nach SR-Feedback 2026-03: abgeleitete Werte, Bedingungsregeln,
# Datenquellen, OPS-Codes, Zugangsweg-Keywords, Freitext-Hinweise.
#
# Hierarchische Struktur mit logischen Gruppierungen:
# - PatientInfo: Patientenstammdaten
# - CaseTimeline: Aufenthalts- und OP-Zeitdaten
# - SurgicalApproach: Zugangsweg (offen/VATS/RATS)
# - Procedure: Eingriffsarten
# - SurgicalTeam: Operateur/Assistent
# - Diagnosis: Diagnosen
# - Complication: Komplikationen
# - PathologyOutcome: Pathologie/Resektionsstatus
#
# - Feldnamen bleiben DE, Property-IRIs generator-sicher (ASCII + `_`).
# - csvHeader/excelHeader für TTL->CSV-Kompatibilität.
#################################################################

med: a owl:Ontology ;
  rdfs:label "OP- und Verlaufserfassung (Testcase 1) – Ontologie (Non-Flat)"@de ;
  rdfs:comment "Hierarchisches Schema (DE) für Extraktion. Gruppierung nach fachlichen Domänen; ObjectProperties verknüpfen MedicalCase mit Sub-Entitäten."@de .

med:csvHeader a owl:AnnotationProperty ;
  rdfs:label "CSV-Spaltenname"@de ;
  rdfs:comment "Eindeutiger Spaltenname für die Rückführung TTL -> CSV (disambiguiert, ohne Übersetzung)."@de .

med:excelHeader a owl:AnnotationProperty ;
  rdfs:label "Excel-Spaltenname (Original)"@de ;
  rdfs:comment "Spaltenname wie in der Excel/CSV-Vorlage (kann Duplikate/Trailing-Spaces enthalten)."@de .

med:valueKind a owl:AnnotationProperty ;
  rdfs:label "Value kind"@en ;
  rdfs:comment "Machine-readable value shape for extraction/prompt generation. Allowed literals: binary_checklist (active value typically \"1\", otherwise omit), free_text_fallback (catch-all text only when no canonical/binary sibling fits), free_text (ordinary string), derived (computed from other fields; do not invent from prose alone)."@en .

#################################################################
# Top-Level Class
#################################################################

med:MedicalCase a owl:Class ;
  rdfs:label "Medizinischer Fall"@de ;
  rdfs:comment "Ein Fall / Aufenthalt / OP-Episode (eine Zeile in der strukturierten Erfassung). Verknüpft mit PatientInfo, CaseTimeline, SurgicalApproach, Procedure, SurgicalTeam, Diagnosis, Complication, PathologyOutcome."@de .

#################################################################
# Sub-Classes (logische Gruppierungen)
#################################################################

med:PatientInfo a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Patientenstammdaten"@de ;
  rdfs:comment "Patientenidentifikation und demografische Daten. Diese Felder sind aus patientenbezogenen Stammdaten, Fallkopf, Aufnahme-/Arztbrief- oder vergleichbaren Patientenidentifikationsstellen zu befuellen. Namen aus OP-Team-, Operateur-, Assistenz- oder Behandlerlisten duerfen NICHT als PatientInfo uebernommen werden, auch wenn sie in derselben Quelle prominent erscheinen."@de .

med:CaseTimeline a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Aufenthalts- und OP-Zeitdaten"@de ;
  rdfs:comment "Zeitliche Daten zum Aufenthalt, OP und Entlassung."@de .

med:SurgicalApproach a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Zugangsweg"@de ;
  rdfs:comment "Operativer Zugang: offen, VATS, RATS. Alle drei Felder sind BINARY CHECKLIST Felder (valueKind=binary_checklist) und moeglichst gegenseitig ausschliessend. WICHTIG: Fuer einen Fall ist der final abgeschlossene Zugangsweg entscheidend; fruehe Setup- oder Zugangsbeschreibungen sind nachrangig, wenn spaeter eine klare finale Klassifikation oder Konversion beschrieben wird."@de .

med:Procedure a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Eingriffsart"@de ;
  rdfs:comment "Durchgeführte operative Eingriffe (OPS-Codes). WICHTIG: Die meisten Procedure-Felder sind BINARY CHECKLIST Felder (valueKind=binary_checklist): bei Quellbeleg \"1\", sonst weglassen. BINARY/kanonische Eingriffsfelder haben Vorrang vor Freitext. Wenn der OP-Bericht eine eigene `Operation:`-, `Eingriff:`- oder sonstige Zusammenfassungszeile mit expliziten Eingriffsbezeichnungen enthaelt, ist diese fuer die Zuordnung der kanonischen Eingriffsfelder besonders stark zu gewichten. Solche explizit benannten kanonischen Eingriffe sollen erhalten bleiben und NICHT spaeter durch generische Freitexteintraege wie `sonst. (Eingriff)` verdraengt werden. `sonst. (Eingriff)` (valueKind=free_text_fallback) ist nur fuer explizite, nicht anderweitig abbildbare Eingriffe gedacht."@de .

med:SurgicalTeam a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "OP-Team"@de ;
  rdfs:comment "Operateur und Assistent. Die Rollen sind getrennt zu halten; Personen duerfen nicht allein wegen ihrer Naehe im Dokument oder gemeinsamer Auflistung zusammengelegt werden. Wenn der OP-Bericht eine explizite Rollenstruktur (Operateur/In, Assistenz) vorgibt, ist diese gegenueber unstrukturierten Namenslisten vorrangig. OCR-/Layout-Artefakte sind mitzudenken: Wenn Rollenlabels sichtbar sind, die zugehoerigen Inline-Werte aber nur aus Titeln/Platzhaltern bestehen (z.B. `Dr. med.`) und unmittelbar daneben oder darunter eine kleine, geordnete Namensliste im selben Teamkopf erscheint, darf diese Namensliste zur Rollenbefuellung herangezogen werden. In diesem Sonderfall gilt die Quellreihenfolge: erster Name = Operateur, zweiter Name = Assistent, sofern keine entgegenstehende explizite Rollenangabe existiert."@de .

med:Diagnosis a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Diagnose"@de ;
  rdfs:comment "Diagnosen des Falls. Die meisten Diagnosis-Felder sind BINARY CHECKLIST Felder (valueKind=binary_checklist): bei Quellbeleg \"1\", sonst weglassen. BINARY/kanonische Diagnosefelder haben Vorrang vor Freitext-Fallbacks. Explizite fallbezogene `Diagnose:`-, `Indikation:`- oder vergleichbare ueberschriebene Diagnosezeilen sind starke Evidenz. Wo ein kanonisches Diagnosefeld passt, ist dieses gegenueber Freitext-Fallbacks zu bevorzugen. `sonst. (Diagnose)` (valueKind=free_text_fallback) ist nur fuer explizite, nicht kanonisch abdeckbare Diagnosen zu verwenden."@de .

med:Complication a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Komplikation"@de ;
  rdfs:comment "Postoperative Komplikationen und Clavien-Dindo. Massgeblich sind fallbezogene postoperative Komplikationen im Zeitraum OP bis Entlassung. Intraoperative technische Ereignisse, unmittelbare Reventilations-/Umlagerungsbeobachtungen oder rein logistische Intensivverlegung sind ohne explizite Komplikationskennzeichnung nicht automatisch als postoperative Komplikation zu werten."@de .

med:PathologyOutcome a owl:Class ;
  rdfs:subClassOf owl:Thing ;
  rdfs:label "Pathologie"@de ;
  rdfs:comment "Stadium und Resektionsstatus (R0/R1/R2). Massgeblich ist der endgueltige pathologische bzw. histologische Befund. Provisorische intraoperative Aussagen (z.B. Schnellschnitt/Frozen Section) sind nachrangig und duerfen nicht als endgueltiges Pathologieergebnis uebernommen werden, sofern kein endgueltiger Befund daraus gemacht wird."@de .

#################################################################
# Object Properties (MedicalCase -> Sub-Entitäten)
#################################################################

med:hasPatientInfo a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:PatientInfo ;
  rdfs:label "hat Patientenstammdaten"@de ;
  rdfs:comment "Verknüpfung mit Patientenstammdaten."@de .

med:hasTimeline a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:CaseTimeline ;
  rdfs:label "hat Aufenthaltsdaten"@de ;
  rdfs:comment "Verknüpfung mit zeitlichen Aufenthaltsdaten."@de .

med:hasSurgicalApproach a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:SurgicalApproach ;
  rdfs:label "hat Zugangsweg"@de ;
  rdfs:comment "Verknüpfung mit operativem Zugang."@de .

med:hasProcedure a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:Procedure ;
  rdfs:label "hat Eingriff"@de ;
  rdfs:comment "Verknüpfung mit durchgeführten Eingriffen."@de .

med:hasSurgicalTeam a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:SurgicalTeam ;
  rdfs:label "hat OP-Team"@de ;
  rdfs:comment "Verknüpfung mit Operateur und Assistent."@de .

med:hasDiagnosis a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:Diagnosis ;
  rdfs:label "hat Diagnose"@de ;
  rdfs:comment "Verknüpfung mit Diagnosen."@de .

med:hasComplication a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:Complication ;
  rdfs:label "hat Komplikation"@de ;
  rdfs:comment "Verknüpfung mit Komplikationen."@de .

med:hasPathologyOutcome a owl:ObjectProperty ;
  rdfs:domain med:MedicalCase ;
  rdfs:range med:PathologyOutcome ;
  rdfs:label "hat Pathologie"@de ;
  rdfs:comment "Verknüpfung mit pathologischem Ergebnis."@de .

#################################################################
# PatientInfo – Datatype Properties
#################################################################

med:Name a owl:DatatypeProperty ;
  rdfs:domain med:PatientInfo ;
  rdfs:range xsd:string ;
  rdfs:label "Name"@de ;
  med:csvHeader "Name" ;
  med:excelHeader "Name" ;
  rdfs:comment "PATIENTENNAME: Wenn ein patientenbezogener Kopf-/Stammdatenblock nahe Fall-Nr/Geburtsdatum einen Namen als `Nachname, Vorname` enthaelt, MUSS `Vorname Nachname` ausgegeben werden. Das Feld nicht weglassen, nur weil Fall_Nr oder Geburtsdatum bereits extrahiert wurden. Namen aus OP-Team-, Operateur-, Assistenz-, Behandler- oder Autorenlisten duerfen NICHT als PatientInfo uebernommen werden. Wert ist genau ein kanonischer Name, keine Alternativenliste. Beispiel: `Meyer, Claudia` -> `Claudia Meyer`."@de  ;
  med:valueKind "free_text" .


med:Fall_Nr a owl:DatatypeProperty ;
  rdfs:domain med:PatientInfo ;
  rdfs:range xsd:string ;
  rdfs:label "Fall-Nr"@de ;
  med:csvHeader "Fall-Nr" ;
  med:excelHeader "Fall-Nr" ;
  rdfs:comment "Die Fallnummer besteht aus 9 Ziffern und wird benutzt, um den Aufenthalt eines Patienten zu identifizieren. Ein Patient erhält für jeden Besuch eine Fallnummer."@de  ;
  med:valueKind "free_text" .


med:Geburtsdatum a owl:DatatypeProperty ;
  rdfs:domain med:PatientInfo ;
  rdfs:range xsd:string ;
  rdfs:label "Geburtsdatum"@de ;
  med:csvHeader "Geburtsdatum" ;
  med:excelHeader "Geburtsdatum" ;
  rdfs:comment "Das Geburtsdatum wird in folgendem Format angegeben: TT.MM.JJJJ (T=Tag, M=Monat, J=Jahr)."@de  ;
  med:valueKind "free_text" .


med:Alter a owl:DatatypeProperty ;
  rdfs:domain med:PatientInfo ;
  rdfs:range xsd:integer ;
  rdfs:label "Alter"@de ;
  med:csvHeader "Alter" ;
  med:excelHeader "Alter" ;
  rdfs:comment "Das Alter bezieht sich auf das Alter zum Zeitpunkt der Operation. ABGELEITETER WERT: Es errechnet sich aus der Zeit zwischen Geburtsdatum und OP-Datum und muss nicht manuell befüllt werden."@de  ;
  med:valueKind "derived" .


#################################################################
# CaseTimeline – Datatype Properties
#################################################################

med:OP_Datum a owl:DatatypeProperty ;
  rdfs:domain med:CaseTimeline ;
  rdfs:range xsd:string ;
  rdfs:label "OP-Datum"@de ;
  med:csvHeader "OP-Datum" ;
  med:excelHeader "OP-Datum " ;
  rdfs:comment "Das OP-Datum ist das Operationsdatum und wird in folgendem Format angegeben: TT.MM.JJJJ (T=Tag, M=Monat, J=Jahr)."@de  ;
  med:valueKind "free_text" .


med:Same_Day_Surgery a owl:DatatypeProperty ;
  rdfs:domain med:CaseTimeline ;
  rdfs:range xsd:string ;
  rdfs:label "Same Day Surgery"@de ;
  med:csvHeader "Same Day Surgery" ;
  med:excelHeader "Same Day Surgery" ;
  rdfs:comment "Bezeichnet den Fall, dass die stationäre Aufnahme am Tag der Operation erfolgt und nicht bereits am Tag zuvor. ABLEITBAR aus Aufnahmedatum (Arztbrief) und OP-Datum: Aufnahmedatum = OP-Datum → j, sonst n. DATENQUELLE: Aufnahmedatum muss im Arztbrief vorhanden sein; ohne diesen Eintrag kann das Feld nicht zuverlässig befüllt werden."@de  ;
  med:valueKind "free_text" .


med:praeop_TuKo a owl:DatatypeProperty ;
  rdfs:domain med:CaseTimeline ;
  rdfs:range xsd:string ;
  rdfs:label "präop TuKo"@de ;
  med:csvHeader "präop TuKo" ;
  med:excelHeader "präop TuKo" ;
  rdfs:comment "Vorliegen mehrerer Konferenzen; die letzte Konferenz, welche unmittelbar vor der Operation (OP-Datum) stattgefunden hat. DATENQUELLE: Datum aus dem Tumorkonferenzbeschluss. Ohne diesen ist das Feld nicht befüllbar (und damit auch \"Dauer (d) zwischen TuKo und OP\" nicht ableitbar)."@de  ;
  med:valueKind "free_text" .


med:Entlassdatum a owl:DatatypeProperty ;
  rdfs:domain med:CaseTimeline ;
  rdfs:range xsd:string ;
  rdfs:label "Entlassdatum"@de ;
  med:csvHeader "Entlassdatum" ;
  med:excelHeader "Entlassdatum" ;
  rdfs:comment "Das Entlassdatum wird in folgendem Format angegeben: TT.MM.JJJJ (T=Tag, M=Monat, J=Jahr). DATENQUELLE: QM-Bogen oder Arztbrief. Ohne diese Quellen ist das Feld nicht befüllbar (und damit Verweildauer nicht ableitbar)."@de  ;
  med:valueKind "free_text" .


med:Verweildauer a owl:DatatypeProperty ;
  rdfs:domain med:CaseTimeline ;
  rdfs:range xsd:integer ;
  rdfs:label "Verweildauer"@de ;
  med:csvHeader "Verweildauer" ;
  med:excelHeader "Verweildauer" ;
  rdfs:comment "Die Verweildauer bezieht sich auf die Tage nach der Operation bis zur Entlassung und wird als volle Anzahl der Tage ohne Nachkommastellen angegeben. ABGELEITETER WERT: Berechnung aus OP-Datum und Entlassdatum (Tag nach OP bis Entlassdatum inklusive)."@de  ;
  med:valueKind "free_text" .


med:Dauer_d_zwischen_TuKo_und_OP a owl:DatatypeProperty ;
  rdfs:domain med:CaseTimeline ;
  rdfs:range xsd:integer ;
  rdfs:label "Dauer (d) zwischen TuKo und OP"@de ;
  med:csvHeader "Dauer (d) zwischen TuKo und OP" ;
  med:excelHeader "Dauer (d) zwischen TuKo und OP" ;
  rdfs:comment "Die Dauer in Tagen (d) von der Tumorkonferenz bis zur OP. ABGELEITETER WERT: Berechnung aus präop TuKo und OP-Datum (erster Tag nach TuKo bis OP-Datum inklusive). Voraussetzung: präop TuKo muss befüllt sein."@de  ;
  med:valueKind "free_text" .


#################################################################
# SurgicalApproach – Datatype Properties
#################################################################

med:offen a owl:DatatypeProperty ;
  rdfs:domain med:SurgicalApproach ;
  rdfs:range xsd:string ;
  rdfs:label "offen"@de ;
  med:csvHeader "offen" ;
  med:excelHeader "offen" ;
  rdfs:comment "OFFEN PRIORITAET: Wenn ein Procedure-Kommentar denselben Quellbefund als offene Dekortikation/offen einordnet, dann `offen` = \"1\" und `VATS` leer lassen. Bei Pleuraempyem/Fibrothorax gilt die Formulierung `thorakoskopische Resektion der viszeralen Pleura mit Dekortikation der Lunge` ohne explizite VATS-Dekortikation/OPS-Evidenz als `offen`. Sonstige starke Evidenz: Thorakotomie, Sternotomie, offener Zugang, Thorax wird offen eroefnet, Konversion auf offenen Zugang. Entscheidend ist der FINALE Zugang: Wenn der Fall mit uniportal-VATS/Thorakoskopie beginnt, spaeter aber explizit zur Thorakotomie/offen konvertiert und offen abgeschlossen wird, gilt AUSSCHLIESSLICH `offen` = \"1\" und `VATS` bleibt leer. Nicht allein wegen Kamera/Thorakoskopie/minimal-invasiv setzen. POSITIVBEISPIEL: `Entscheid zur Thorakotomie. Thorakotomie.` nach initialer VATS-Passage -> `offen = 1`, `VATS` leer. NEGATIVBEISPIEL: reine thorakoskopische Sympathektomie/Hämatomausräumung ohne Konversion -> NICHT `offen`."@de  ;
  med:valueKind "binary_checklist" .


med:VATS a owl:DatatypeProperty ;
  rdfs:domain med:SurgicalApproach ;
  rdfs:range xsd:string ;
  rdfs:label "VATS"@de ;
  med:csvHeader "VATS" ;
  med:excelHeader "VATS" ;
  rdfs:comment "VATS NUR bei finalem VATS-Zugang. NICHT setzen fuer `thorakoskopische Resektion der viszeralen Pleura mit Dekortikation der Lunge`, wenn der Procedure-Kommentar diese Formulierung als offene Dekortikation/offen einordnet. Initiale thorakoskopische Passage allein reicht NICHT, wenn spaeter Konversion/final offen beschrieben wird (dann nur `offen`). Roboter -> RATS, nicht VATS. POSITIVBEISPIELE fuer finalen VATS-Zugang: `uniportal-VATS` ohne Konversion; `thorakoskopische Hämatomausräumung`; thorakale Sympathektomie mit Optik/Alexis-Folie und ohne Thorakotomie/Konversion; Operationstext `thorakoskopisch` als finaler Zugang. NEGATIVBEISPIEL: `Markierung zur uniportal-VATS` gefolgt von `Entscheid zur Thorakotomie` -> NICHT `VATS`, sondern nur `offen`."@de  ;
  med:valueKind "binary_checklist" .


med:RATS a owl:DatatypeProperty ;
  rdfs:domain med:SurgicalApproach ;
  rdfs:range xsd:string ;
  rdfs:label "RATS"@de ;
  med:csvHeader "RATS" ;
  med:excelHeader "RATS" ;
  rdfs:comment "Roboter-assistierte Thorakoskopie. KEYWORDS: roboter-assistierte Thorakoskopie, robotisch, Da Vinci, daVinci Xi, Roboterarm. STARKE EVIDENZ sind auch indirekte, aber fallbezogen operative Formulierungen wie `thorakoskopische Technik mit der Modifikation einer Roboterassistenz`, `mit da Vinci-Robotersystem`, `Roboterassistenz`, das Andocken/Ankoppeln der Roboterarme oder die Vorbereitung/Benutzung der Roboterkonsole, sofern diese den tatsaechlich durchgefuehrten Zugang des Falls beschreiben. Abgrenzung zu VATS: Sobald der eigentliche fallbezogene Zugang mit Roboter beschrieben wird, ist `RATS` zu setzen und NICHT `VATS`, auch wenn im selben Satz zugleich `thorakoskopisch` oder `minimal-invasiv` genannt wird. Wenn eine Konversion auf offenen Zugang beschrieben wird, gilt am Ende AUSSCHLIESSLICH `offen`; `RATS` darf dann NICHT zusaetzlich mit \"1\" befuellt werden. Entscheidend ist der finale durchgefuehrte Zugang, nicht bloss die Erwaehnung robotischer Unterstuetzung in einem verworfenen oder vorbereitenden Schritt. POSITIVBEISPIEL: `minimal-invasiv mit Roboterassistenz durchgefuehrt` -> `RATS = 1`. NEGATIVBEISPIEL: `robotische Unterstuetzung war vorbereitet, Eingriff dann offen abgeschlossen` -> NICHT `RATS`, sondern nur `offen`. Liegen Kriterien fuer RATS vor: \"1\", sonst kein Eintrag."@de  ;
  med:valueKind "binary_checklist" .


#################################################################
# Procedure – Datatype Properties (Eingriffsarten)
#################################################################

med:atypische_Resektion_5_322 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "atypische Resektion (5-322)"@de ;
  med:csvHeader "atypische Resektion (5-322)" ;
  med:excelHeader "atypische Resektion (5-322)" ;
  rdfs:comment "Eine atypische Resektion (syn. Keilresektion, Wedgeresektion) ist eine Eingriffsart und bezeichnet das Entfernen von Lungengewebe, welches KEINEN anatomischen Segment- oder Lappengrenzen folgt. Nachvollziehen laesst sich dies in der Regel aus dem OP-Bericht. Wenn der Block `Operation:` / `Eingriff:` eine explizite Zeile mit atypischer Resektion/Keilresektion enthaelt, MUSS dieses Feld \"1\" sein, auch wenn zusaetzlich Adhaesiolyse, Konversion oder andere Begleitschritte genannt werden. NUR bei explizitem Hinweis auf Keilresektion/Wedgeresektion/atypische Resektion oder klar nicht-anatomische Resektion ist \"1\" einzutragen. NICHT hier eintragen, wenn stattdessen explizit Segmentresektion, Lobektomie/Bilobektomie oder Pneumonektomie beschrieben ist. Es koennen mehrere Eingriffsarten gleichzeitig vorliegen, aber eine anatomische Resektion allein ist KEIN Beleg fuer atypische Resektion. POSITIVBEISPIEL: `Atypische Lungenresektion: Keilresektion, mehrfach, offen chirurgisch` -> \"1\". Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen. Er ist aber nicht immer vorhanden und nicht zwingend notwendig."@de  ;
  med:valueKind "binary_checklist" .


med:Segmenresektion_5_323_4_7 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Segmenresektion (5-323.4-7)"@de ;
  med:csvHeader "Segmenresektion (5-323.4-7)" ;
  med:excelHeader "Segmenresektion (5-323.4-7)" ;
  rdfs:comment "Eine Segmentresektion ist eine Eingriffsart und bezeichnet das Entfernen von Lungengewebe entlang der anatomischen Segmentgrenze. Nachvollziehen laesst sich dies in der Regel aus dem OP-Bericht. NUR bei explizitem Hinweis auf Segmentresektion, Segmentektomie, Bisegmentektomie oder Trisegmentektomie ist \"1\" einzutragen. Auch gebräuchliche OP-Kurzformen wie `S6-Resektion`, `S6 Rx`, `Segment-6-Resektion` oder entsprechende segmentbezogene anatomische Resektionskürzel gelten als starke Evidenz, sofern sie fallbezogen den durchgefuehrten Eingriff bezeichnen. NICHT hier eintragen, wenn lediglich atypische Resektion/Keilresektion oder Lobektomie/Bilobektomie beschrieben ist. Erfolgt das Entfernen von mehreren Segmenten waehrend einer Operation, bleibt es beim Eintrag \"1\". Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen. Er ist aber nicht immer vorhanden und nicht zwingend notwendig."@de  ;
  med:valueKind "binary_checklist" .


med:Lobektomie_Bilobektomie_5_324_5_325 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Lobektomie/Bilobektomie (5-324, 5-325)"@de ;
  med:csvHeader "Lobektomie/Bilobektomie (5-324, 5-325)" ;
  med:excelHeader "Lobektomie/Bilobektomie (5-324, 5-325)" ;
  rdfs:comment "Eine Lobektomie/Bilobektomie ist eine Eingriffsart und bezeichnet das Entfernen eines Lungenlappens bzw. von zwei Lappen entlang der anatomischen Lappengrenze. Nachvollziehen laesst sich dies in der Regel aus dem OP-Bericht. NUR bei explizitem Hinweis auf Lobektomie, Bilobektomie oder Entfernung eines ganzen Lappens/einer ganzen Lappenkombination ist \"1\" einzutragen. NICHT hier eintragen, wenn lediglich Segmentresektion, atypische Resektion/Keilresektion oder andere nicht-lappenspezifische Eingriffe beschrieben sind. Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen. Er ist aber nicht immer vorhanden und nicht zwingend notwendig."@de  ;
  med:valueKind "binary_checklist" .


med:Pneumonektomie_5_327 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Pneumonektomie (5-327)"@de ;
  med:csvHeader "Pneumonektomie (5-327)" ;
  med:excelHeader "Pneumonektomie (5-327)" ;
  rdfs:comment "Eine Pneumonektomie ist eine Eingriffsart und bezeichnet das Entfernen von Lungengewebe, welches einem kompletten Lungenflügel entspricht. Nachvollziehen lässt sich dies in der Regel aus dem OP-Bericht. Liegt eine Pneumonektomie vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es können mehrere Eingriffsarten gleichzeitig vorliegen. Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen. Er ist aber nicht immer vorhanden und nicht zwingend notwendig."@de  ;
  med:valueKind "binary_checklist" .


med:erw_Pneumonektomie_5_328 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "erw. Pneumonektomie (5-328)"@de ;
  med:csvHeader "erw. Pneumonektomie (5-328)" ;
  med:excelHeader "erw. Pneumonektomie (5-328)" ;
  rdfs:comment "Eine erw. (erweiterte) Pneumonektomie ist eine Eingriffsart und bezeichnet das Entfernen von Lungengewebe, welches einem kompletten Lungenflügel entspricht. Erweitert ist die Resektion, wenn es zur Mitresektion benachbarter Strukturen wie Anteile des Diaphragmas oder des Perikards u.a. kommt. Bei Befall der Pleura wird der Lungenflügel mit dem Lungenfell en bloc entnommen (extrapleurale Pneumonektomie). Nachvollziehen lässt sich dies in der Regel aus dem OP-Bericht. Liegt eine erw. Pneumonektomie vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es können mehrere Eingriffsarten gleichzeitig vorliegen. Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen. Er ist aber nicht immer vorhanden und nicht zwingend notwendig."@de  ;
  med:valueKind "binary_checklist" .


med:offene_Dekortikation_5_344_0_5_344_11_5_344_13_5_345_1 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "offene Dekortikation (5-344.0, 5-344.11, 5-344.13, 5-345.1)"@de ;
  med:csvHeader "offene Dekortikation (5-344.0, 5-344.11, 5-344.13, 5-345.1)" ;
  med:excelHeader "offene Dekortikation (5-344.0, 5-344.11, 5-344.13, 5-345.1)" ;
  rdfs:comment "PRIORITAET: Bei Pleuraempyem/Fibrothorax ist `thorakoskopische Resektion der viszeralen Pleura mit Dekortikation der Lunge` als offene Dekortikation zu werten: dieses Feld = \"1\" und SurgicalApproach.offen = \"1\". Nicht als VATS_Dekortikation werten, ausser die Quelle nennt explizit `VATS-Dekortikation` oder einen VATS-spezifischen OPS-Code. Offene Dekortikation bedeutet Entfernung der viszeralen Pleura/Dekortikation der Lunge und ist stets als offen zu klassifizieren."@de  ;
  med:valueKind "binary_checklist" .


med:VATS_Dekortikation_5_344_3_5_345_4 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "VATS Dekortikation (5-344.3, 5-345.4)"@de ;
  med:csvHeader "VATS Dekortikation (5-344.3, 5-345.4)" ;
  med:excelHeader "VATS Dekortikation (5-344.3, 5-345.4)" ;
  rdfs:comment "NEGATIVREGEL: `thorakoskopische Resektion der viszeralen Pleura mit Dekortikation der Lunge` ist ohne explizite `VATS-Dekortikation` oder VATS-spezifischen OPS-Code KEINE VATS_Dekortikation. Nur setzen, wenn Dekortikation vorliegt UND der finale Zugang ausdruecklich VATS/RATS und nicht offen ist. Wenn offene_Dekortikation fuer denselben Befund greift, dieses Feld leer lassen."@de  ;
  med:valueKind "binary_checklist" .


med:Pleurektomie_5_344_1_2_u_4_5 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Pleurektomie (5-344.1-2 u 4-5)"@de ;
  med:csvHeader "Pleurektomie (5-344.1-2 u 4-5)" ;
  med:excelHeader "Pleurektomie (5-344.1-2 u 4-5)" ;
  rdfs:comment "Eine Pleurektomie ist eine Eingriffsart und bezeichnet das Entfernen der parietalen Pleura von der Brustwand. Hierbei kann die Pleura lokal (Probeexzision), subtotal oder total erfolgen. Alle diese Eingriffsarten fallen unter die Kategorie Pleurektomie. Nachvollziehen lässt sich dies in der Regel aus dem OP-Bericht. Liegt eine Pleurektomie vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es können mehrere Eingriffsarten gleichzeitig vorliegen. Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen."@de  ;
  med:valueKind "binary_checklist" .


med:plast_Rekonstruktion_der_Brustwand_5_346 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "plast. Rekonstruktion der Brustwand (5-346)"@de ;
  med:csvHeader "plast. Rekonstruktion der Brustwand (5-346)" ;
  med:excelHeader "plast. Rekonstruktion der Brustwand (5-346)" ;
  rdfs:comment "Eine plast. (plastische) Rekonstruktion der Brustwand ist eine Eingriffsart, bei der die Brustwand rekonstruiert wird. Die Rekonstruktion beschreibt hierbei eine Wiederherstellung der Brustwand, die über einen reinen Wundverschluss hinausgeht. Meist werden Fremdmaterialien wie Netze oder Rippenosteosynthesematerial verwendet. Auch die plastische Deckung (bspw. Lappenplastik) fällt unter diese Eingriffsart. Nachvollziehen lässt sich dies in der Regel aus dem OP-Bericht. Liegt eine plast. Rekonstruktion der Brustwand vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es können mehrere Eingriffsarten gleichzeitig vorliegen. Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen."@de  ;
  med:valueKind "binary_checklist" .


med:Trachearesektion_und_andere_Eingriffe_an_der_Trachea_5_314_5_316_5_319 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Trachearesektion und andere Eingriffe an der Trachea (5-314, 5-316, 5-319)"@de ;
  med:csvHeader "Trachearesektion und andere Eingriffe an der Trachea (5-314, 5-316, 5-319)" ;
  med:excelHeader "Trachearesektion und andere Eingriffe an der Trachea (5-314, 5-316, 5-319)" ;
  rdfs:comment "Eine Trachearesektion und andere Eingriffe an der Trachea beinhaltet jeden Eingriff, der die Trachea betrifft. Ausgenommen sind Bronchoplastiken, die unter Angio-/Bronchoplastik subsumiert werden. Nachvollziehen lässt sich dies in der Regel aus dem OP-Bericht. Liegt eine Trachearesektion und andere Eingriffe an der Trachea vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es können mehrere Eingriffsarten gleichzeitig vorliegen. Der Zahlencode in Klammern bezeichnet den OPS-Code und kann als Hinweis auf die Resektion dienen."@de  ;
  med:valueKind "binary_checklist" .


med:Mediastinaltumorresektion_5_342 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Mediastinaltumorresektion (5-342)"@de ;
  med:csvHeader "Mediastinaltumorresektion (5-342)" ;
  med:excelHeader "Mediastinaltumorresektion (5-342)" ;
  rdfs:comment "Mediastinaltumorresektion: Entfernung eines Mediastinaltumors (Thymom, Thymuskarzinom, andere). Setzt i.d.R. Mediastinaltumor-Diagnose oder eine explizite mediastinale Tumorindikation voraus. OPS: 5-342. STARKE EVIDENZ sind explizite OP-Zusammenfassungen oder Berichtsstellen mit Benennungen wie Tumorresektion, en bloc Tumorresektion, Resektion eines Tumors der Thymusloge oder gleichwertige Formulierungen einer mediastinalen Tumorentfernung. Formulierungen wie `komplette Thymektomie mit en bloc Tumorresektion`, `Tumorresektion in der Thymusloge`, `Resektion des vorderen Mediastinaltumors` oder gleichwertige kombinierte OP-Zeilen gelten ebenfalls als starke Evidenz fuer dieses Feld. Wenn eine Thymektomie explizit gemeinsam mit einer en bloc Tumorresektion eines mediastinalen Tumors beschrieben wird, koennen beide kanonischen Eingriffsfelder gleichzeitig vorliegen; `Thymektomie` ersetzt dieses Feld dann nicht. Nicht ausreichend sind bloss allgemeine Freilegungs-, Mobilisations- oder Praeparationsformeln ohne eigentliche Tumorentfernung. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Pleurodese_5_345_ohne_5_345_1_und_ohne_5_345_4 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Pleurodese (5-345 ohne 5-345.1 und ohne 5-345.4)"@de ;
  med:csvHeader "Pleurodese (5-345 ohne 5-345.1 und ohne 5-345.4)" ;
  med:excelHeader "Pleurodese (5-345 ohne 5-345.1 und ohne 5-345.4)" ;
  rdfs:comment "Pleurodese: Verkleben der Pleurablätter (viszeral/parietal), z.B. bei chronischem Erguss oder Pneumothorax; chemisch (Talkum) oder mechanisch (Pleurektomie). Kann MIT Pleurektomie vorliegen (beide \"1\"), NICHT mit Dekortikation. OPS: 5-345 ohne 5-345.1 und 5-345.4. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Thymektomie a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Thymektomie"@de ;
  med:csvHeader "Thymektomie" ;
  med:excelHeader "Thymektomie" ;
  rdfs:comment "Thymektomie: Entfernung der Thymusdrüse. Indikation: Myasthenia gravis oder en-bloc bei Mediastinaltumor. OPS-Code (Referenz): 5-077. STARKE EVIDENZ sind explizite OP-Zusammenfassungen oder Eingriffszeilen mit Formulierungen wie `Thymektomie`, `komplette Thymektomie`, `erweiterte Thymektomie` oder gleichwertige explizite Benennungen der Entfernung der Thymusdruese. Bei gleichzeitigem Vorliegen von Mediastinaltumorresektion: beide Spalten \"1\"; eine kombinierte Formulierung wie `Thymektomie mit en bloc Tumorresektion` ist daher fuer BEIDE Felder starke Evidenz. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Mediastinoskopie_1_586_3_1_691_1_5_401_7_5_402_d a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Mediastinoskopie (1-586.3, 1-691.1, 5-401.7, 5-402.d)"@de ;
  med:csvHeader "Mediastinoskopie (1-586.3, 1-691.1, 5-401.7, 5-402.d)" ;
  med:excelHeader "Mediastinoskopie (1-586.3, 1-691.1, 5-401.7, 5-402.d)" ;
  rdfs:comment "Mediastinoskopie: minimal-invasives endoskopisches Verfahren zur Spiegelung des Mittelfellraums, Biopsie von Lymphknoten/Tumoren. HINWEIS: Mediastinoskopie ist typischerweise NICHT als offener Zugang zu klassifizieren. OPS: 1-586.3, 1-691.1, 5-401.7, 5-402.d. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:VAMLA_5_404_8 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "VAMLA (5-404.8)"@de ;
  med:csvHeader "VAMLA (5-404.8)" ;
  med:excelHeader "VAMLA (5-404.8)" ;
  rdfs:comment "VAMLA (Video-assistierte mediastinoskopische Lymphadenektomie): Lymphknotenentfernung im Mediastinum unter Videokontrolle, v.a. Staging NSCLC. HINWEIS: VAMLA erfordert Zugangsweg VATS oder RATS (nicht offen). OPS: 5-404.8. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Thoraxdrainageneinlage_8_144_0_und_5_340_0 a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Thoraxdrainageneinlage (8-144.0 und 5.340.0)"@de ;
  med:csvHeader "Thoraxdrainageneinlage (8-144.0 und 5.340.0)" ;
  med:excelHeader "Thoraxdrainageneinlage (8-144.0 und 5.340.0)" ;
  rdfs:comment "Thoraxdrainageneinlage als EIGENER Eingriff (offene oder kleinlumige Drainage). NUR dann \"1\", wenn die Drainage im Fall als eigenstaendige interventionelle oder operative Massnahme beschrieben ist. NICHT eintragen bei routinemaessiger postoperativer Drainage, bei Abschluss-/Standarddrainagen nach einem anderen thoraxchirurgischen Haupteingriff oder wenn die Drainage nur als Teil des ueblichen Wundverschluss-/Reventilations-/Ausleitungsschritts beschrieben wird. Formulierungen wie Einlage einer Thoraxdrainage ueber Trokarinzision, Anschluss an Sog, Fixation der Drainage, Spuelsystem zur Prophylaxe oder blosse Nennung von Lavage und Drainage innerhalb der Abschlussbeschreibung eines anderen Haupteingriffs reichen fuer dieses Feld allein NICHT aus. Auch eine reine Abschlussformel wie Einlage einer links-/rechtsseitigen Thoraxdrainage nach Kontrolle des Operationsfeldes oder nach Re-Ventilation ist in der Regel KEINE starke Evidenz fuer dieses Feld, solange die Quelle die Drainage nicht als eigenen zusaetzlichen Eingriff herausstellt. Insbesondere eine sequenzielle Abschlussbeschreibung wie `Einlage einer Thoraxdrainage`, danach `Fixierung`, `Anschluss an Sog/Pumpe`, `Reventilation`, `Extubation` oder Verlegung in den Aufwachraum spricht REGELHAFT fuer routinemaessige Abschlussdrainage und NICHT fuer dieses Feld. POSITIVBEISPIEL: `separate Drainageanlage als eigener Eingriff` oder `PleurX-Verweildrainage zusaetzlich implantiert` -> `1`. NEGATIVBEISPIEL: `am Ende Einlage der Thoraxdrainage, Anschluss an Sog, Extubation` -> KEIN Eintrag. AUSNAHME: PleurX-/ArgentiC-Verweilsystem oder andere explizit als zusaetzlicher eigener Eingriff beschriebene Drainagesysteme koennen zusaetzlich zu anderem Eingriff stehen. OPS: 8-144.0, 5-340.0. In typischen Thoraxchirurgie-Faellen ist dies haeufig \"nein\". Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Angio_Bronchoplastik a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Angio-/Bronchoplastik"@de ;
  med:csvHeader "Angio-/Bronchoplastik" ;
  med:excelHeader "Angio-/Bronchoplastik" ;
  rdfs:comment "Angio-/Bronchoplastik: zusätzliche Entfernung von Gefäß-/Bronchusgewebe (oft bei Tumorinfiltration) mit Nahtverbindung, typisch bei erweiterten Lobektomien. OPS-Code (Referenz): 5-324, 5-325. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:ICMB a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "ICMB"@de ;
  med:csvHeader "ICMB" ;
  med:excelHeader "ICMB" ;
  rdfs:comment "ICMB (Intercostalmuskelbiopsie): Entfernung von Muskelgewebe aus dem Interkostalraum zur Probengewinnung. OPS-Code (Referenz): 1-502.4. Die explizite Abkuerzung `ICMB` in einer OP-Zusammenfassung oder Eingriffszeile gilt bereits als starke Evidenz, auch wenn sie nur als Bestandteil einer komma- oder semikolongetrennten Sammelzeile mit weiteren expliziten Eingriffen genannt wird. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Haematomausraeumung a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "Hämatomausräumung"@de ;
  med:csvHeader "Hämatomausräumung" ;
  med:excelHeader "Hämatomausräumung" ;
  rdfs:comment "Hämatomausräumung: Entfernung von Blutergussbestandteilen aus der Thoraxhöhle. OPS-Code (Referenz): 5-340.c. Wenn `Operation:` / `Eingriff:` explizit Hämatomausräumung, Evakuation eines Hämatoms oder thorakoskopische/offene Hämatomausräumung nennt, MUSS dieses Feld \"1\" sein; der Zugang (VATS/offen) wird separat in SurgicalApproach kodiert und ersetzt dieses Feld nicht. POSITIVBEISPIELE: `Thorakoskopische Hämatomausräumung aus der Pleurahöhle`; `Evakuation des Hämatoms`. NEGATIVBEISPIEL: blosse Diagnose `Hämatothorax` ohne beschriebene Ausräumung/Evakuation -> KEIN Eintrag hier. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:expl_Thorakotomie a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "expl. Thorakotomie"@de ;
  med:csvHeader "expl. Thorakotomie" ;
  med:excelHeader "expl. Thorakotomie" ;
  rdfs:comment "Explorative Thorakotomie: chirurgische Öffnung des Thorax zur direkten Untersuchung (Lunge, Herz, Speiseröhre), Diagnosestellung bei unklaren Befunden. OPS-Code (Referenz): 5-340.1. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:sonst_Eingriff a owl:DatatypeProperty ;
  rdfs:domain med:Procedure ;
  rdfs:range xsd:string ;
  rdfs:label "sonst. (Eingriff)"@de ;
  med:csvHeader "sonst. (Eingriff)" ;
  med:excelHeader "sonst. " ;
  rdfs:comment "FREITEXT-FALLBACK fuer Eingriffe, die keine der anderen genannten erfuellen. Nur eine explizit genannte, fallbezogene, abgeschlossene operative Handlung eintragen, wenn kein kanonisches Eingriffsfeld passt. Kanonische Eingriffsfelder gehen vor. Keine blossen Praeparations-, Mobilisations-, Darstellungs- oder Zugangs-/Setup-Schritte eintragen. Begleitende Zusatzschritte wie eine mit einer kanonischen Resektion zusammen genannte LAD/Lymphadenektomie sollen hier nicht eingetragen werden, wenn dafuer kein eigenes Zielfeld vorgesehen ist und der Haupt-Eingriff bereits anderweitig kodiert wird. Ebenso sollen begleitende Loesungs-, Adhaesiolyse-, Freilegungs- oder Mobilisationshandlungen hier NICHT eingetragen werden, wenn sie nur als Teil der Durchfuehrung eines bereits kanonisch kodierten Haupteingriffs beschrieben werden und nicht als eigenstaendiger separater Eingriff auftreten. Nur wenn die Quelle die Handlung als eigenen abgeschlossenen Eingriff mit eigenstaendigem fallbezogenem Gewicht beschreibt und kein kanonisches Feld passt, darf sie hier stehen. Der Wert soll die kuerzeste passende Originalphrase bleiben. POSITIVBEISPIEL: `Thorakale Sympathektomie` / `thorakale Sympathektomie` als eigener Operationseintrag ohne passendes kanonisches Feld -> hier eintragen (nicht weglassen). NEGATIVBEISPIEL: `Pleurolyse`/`Adhäsiolyse` nur als Begleitschritt zu einer bereits kanonisch kodierten Resektion -> NICHT hier. OPS-Referenz: https://klassifikationen.bfarm.de/ops/"@de  ;
  med:valueKind "free_text_fallback" .


#################################################################
# SurgicalTeam – Datatype Properties
#################################################################

med:Operateur_in a owl:DatatypeProperty ;
  rdfs:domain med:SurgicalTeam ;
  rdfs:range xsd:string ;
  rdfs:label "Operateur/in"@de ;
  med:csvHeader "Operateur/in" ;
  med:excelHeader "Operateur/in" ;
  rdfs:comment "Der Operateur fuehrt die Operation durch. Er ist auf dem OP-Bericht als Operateur vermerkt. Eingetragen wird er als Nachname in die Spalte. Titel, Vornamen und Rollenbezeichnungen sollen nicht uebernommen werden, soweit der Nachname eindeutig bestimmbar ist; wenn der Operateur-Wert aus Titeln plus Personenname besteht (z.B. `Dr. med. Vorname Nachname` oder `Prof. Dr. Nachname`), ist der Titel zu verwerfen, aber der Nachname zu behalten. Ein Feld darf nicht als leer behandelt werden, nur weil vor dem Namen akademische Titel stehen. Es kann mehrere Operateure geben; dann wird die Spalte mit Nachname Operateur 1 / Nachname Operateur 2 / usw. ausgefuellt, getrennt durch ` / ` in stabiler Quellreihenfolge. Wenn die Quelle mehrere Namen gemeinsam als Operateur-Eintrag oder auf einer unlabeled Teamzeile unter leer gebliebenen `Operateur/In`- und `Assistenz`-Feldern auffuehrt, sollen alle diese Namen im Operateur-Feld verbleiben; der zweite Name darf nicht allein wegen seiner Position zu `Assistent/in` umgedeutet werden. Semikolon- oder komma-getrennte Namenslisten in einer Operateur-Zeile (z.B. `Prof. Dr. ... Nachname, Vorname; Nachname2, Vorname2`) zaehlen als gemeinsamer Operateur-Eintrag; daraus sollen die Nachnamen in stabiler Quellreihenfolge als `Nachname1 / Nachname2` uebernommen werden. Eine Aufteilung auf `Assistent/in` ist nur zulaessig, wenn die Quelle die Assistenzrolle explizit zuordnet. Wenn ein sichtbares `Operateur/In`-Label wegen OCR-/Layout-Bruch keinen Namen, sondern nur Titel/Platzhalter traegt, und eine benachbarte/untergeordnete kurze Namensliste denselben Teamkopf fortsetzt, ist der erste dort genannte Personenname als Operateur zu uebernehmen. Operateur und Assistent duerfen nicht in demselben Feld zusammengezogen werden."@de  ;
  med:valueKind "free_text" .


med:Assistent_in a owl:DatatypeProperty ;
  rdfs:domain med:SurgicalTeam ;
  rdfs:range xsd:string ;
  rdfs:label "Assistent/in"@de ;
  med:csvHeader "Assistent/in" ;
  med:excelHeader "Assistent/in" ;
  rdfs:comment "Der Assistent assistiert die Operation. Er ist auf dem OP-Bericht als Assistent vermerkt. Eingetragen wird er als Nachname in die Spalte. Titel, Vornamen und Rollenbezeichnungen sollen nicht uebernommen werden, soweit der Nachname eindeutig bestimmbar ist. Es kann mehrere Assistenten geben; dann wird die Spalte mit Nachname Assistent 1 / Nachname Assistent 2 / usw. ausgefuellt, getrennt durch ` / ` in stabiler Quellreihenfolge. Ein Name darf nur dann hier eingetragen werden, wenn die Quelle die Assistenzrolle explizit zuordnet oder eindeutig als Assistenzliste kennzeichnet. Ein bloss zweiter Name in einer Operateur-Zeile oder in einer unlabeled Teamliste unter leer gebliebenen Rollenfeldern reicht dafuer nicht aus. Wenn sichtbare `Operateur/In`- und `Assistenz`-Labels vorliegen, deren Inline-Werte aber wegen OCR-/Layout-Bruch nur aus Titeln/Platzhaltern bestehen, und dieselbe Teamsektion unmittelbar danach eine kurze geordnete Namensliste fortsetzt, ist der zweite dort genannte Personenname als Assistent zu uebernehmen, sofern keine widersprechende explizite Rollenangabe existiert. Operateur und Assistent duerfen nicht in demselben Feld zusammengezogen werden."@de  ;
  med:valueKind "free_text" .


#################################################################
# Diagnosis – Datatype Properties
#################################################################

med:NSCLC a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "NSCLC"@de ;
  med:csvHeader "NSCLC" ;
  med:excelHeader "NSCLC" ;
  rdfs:comment "Das NSCLC (non-small cell lung cancer, nicht-kleinzelliges Lungenkarzinom) bezeichnet eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. \"1\" NUR dann eintragen, wenn NSCLC oder eine gleichbedeutende fallbezogene Diagnosebezeichnung explizit genannt ist; nicht allein aus Lobektomie, Staging oder allgemeinem Tumorverdacht ableiten. Eine explizit genannte praeoperative oder postoperative Fall-Diagnose zaehlt. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:SCLC a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "SCLC"@de ;
  med:csvHeader "SCLC" ;
  med:excelHeader "SCLC" ;
  rdfs:comment "Das SCLC (small cell lung cancer, kleinzelliges Lungenkarzinom) bezeichnet eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Liegt eine SCLC vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:NET a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "NET"@de ;
  med:csvHeader "NET" ;
  med:excelHeader "NET" ;
  rdfs:comment "Der NET (Neuroendokriner Tumor) bezeichnet eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Liegt ein NET vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Metastasen a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Metastasen"@de ;
  med:csvHeader "Metastasen" ;
  med:excelHeader "Metastasen" ;
  rdfs:comment "Metastasen: Absiedlungen eines anderen Primärtumors. NUR Lungenmetastasen (nicht anderer Organtumor). Art des Primärtumors → Art_der_Metastasen (wenn hier \"1\"). Ersichtlich aus OP-Bericht oder Arztbrief. Es braucht eine fallbezogen explizite Metastasen-/Absiedlungsdiagnose. Unsichere Schnellschnitt-/Frozen-Section-Aussagen wie `ob Metastase oder Primarius kann nicht differenziert werden` reichen allein NICHT aus. POSITIVBEISPIEL: explizite Diagnose `Lungenmetastasen` / `Metastase eines ...` -> \"1\". NEGATIVBEISPIEL: unklare Raumforderung mit Schnellschnitt ohne Metastasenentscheid -> KEIN Eintrag. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Art_der_Metastasen a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Art der Metastasen"@de ;
  med:csvHeader "Art der Metastasen" ;
  med:excelHeader "Art der Metastasen" ;
  rdfs:comment "Art der Metastasen: BEDINGT. Freitext für Primärtumor bzw. Ergebnis der histologischen Untersuchung. NUR ausfüllen, wenn Metastasen = \"1\". Datenquelle: histologischer Befund."@de  ;
  med:valueKind "free_text_fallback" .


med:MG a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "MG"@de ;
  med:csvHeader "MG" ;
  med:excelHeader "MG" ;
  rdfs:comment "Eine MG (Myasthenia gravis) ist eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. \"1\" NUR dann eintragen, wenn Myasthenia gravis/MG im Fall explizit genannt ist; nicht allein aus einer Thymektomie ableiten. Eine explizit genannte Indikations- oder Verdachtsdiagnose des Falls zaehlt. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Thymom a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Thymom"@de ;
  med:csvHeader "Thymom" ;
  med:excelHeader "Thymom" ;
  rdfs:comment "Thymom: Tumor aus Thymusgewebe. GILT AUCH bei explizit fallbezogenem bloessem Verdacht oder Arbeitsdiagnose (z.B. praeoperativ) – dann \"1\" eintragen. Explizite Diagnose-/Indikationszeilen des Falls sind starke Evidenz. Nicht aus allgemeinem Mediastinaltumor, Thymektomie oder unspezifischer Raumforderung allein ableiten. Wenn im Fall stattdessen nur `Thymus-Ca` explizit genannt ist und kein Thymom/Verdacht auf Thymom vorkommt, hier KEIN Eintrag. Ersichtlich aus OP-Bericht oder Arztbrief. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Thymus_Ca a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Thymus-Ca"@de ;
  med:csvHeader "Thymus-Ca" ;
  med:excelHeader "Thymus-Ca" ;
  rdfs:comment "Thymus-Ca (Thymuskarzinom): boesartiger Tumor aus Thymusgewebe, aggressiver als Thymom. Abgrenzung Thymom vs. Thymus-Ca erfolgt histologisch oder durch explizite fallbezogene Benennung. Explizite Diagnose-/Indikationszeilen oder ausdrueckliche Verdachts-/Arbeitsdiagnosen des Falls sind starke Evidenz. \"1\" nur dann eintragen, wenn Thymuskarzinom/Thymus-Ca im Fall explizit genannt ist; nicht allein aus allgemeinem Mediastinaltumor oder Thymektomie ableiten. Andernfalls keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:andere_Mediastinaltumoren a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "andere Mediastinaltumoren"@de ;
  med:csvHeader "andere Mediastinaltumoren" ;
  med:excelHeader "andere Mediastinaltumoren " ;
  rdfs:comment "Andere Mediastinaltumoren bezeichnen Tumoren, deren Ursprung das Mediastinum ist, die weder unter die Kategorie Thymom oder Thymuskarzinom fallen und bezeichnen eine Diagnose. Beispiele hierfür sind z.B. das Teratom oder der M. Castleman. Liegt eine andere Mediastinaltumoren vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Art_des_Mediastinaltumors a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Art des Mediastinaltumors"@de ;
  med:csvHeader "Art des Mediastinaltumors" ;
  med:excelHeader "Art des Mediastinaltumors" ;
  rdfs:comment "Art des Mediastinaltumors: BEDINGT. Freitext für Tumortyp bzw. histologisches Ergebnis. NUR ausfüllen, wenn andere Mediastinaltumoren = \"1\". Datenquelle: histologischer Befund."@de  ;
  med:valueKind "free_text_fallback" .


med:Mesotheliom a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Mesotheliom"@de ;
  med:csvHeader "Mesotheliom" ;
  med:excelHeader "Mesotheliom" ;
  rdfs:comment "Ein Mesotheliom bezeichnet einen bösartigen Tumor, der der Pleura entspringt und ist eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Liegt ein Mesotheliom vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Empyem_Diagnose a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Empyem (Diagnose)"@de ;
  med:csvHeader "Empyem (Diagnose)" ;
  med:excelHeader "Empyem" ;
  rdfs:comment "Ein Empyem bezeichnet eine Eiteransammlung der Pleura, sprich ein Pleuraempyem, und ist eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Liegt ein Empyem vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Destroyed_Lung a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Destroyed Lung"@de ;
  med:csvHeader "Destroyed Lung" ;
  med:excelHeader "Destroyed Lung" ;
  rdfs:comment "Destroyed Lung: Zerstörung des Lungenparenchyms durch Infektion und Abszedierung. Ersichtlich aus OP-Bericht oder Arztbrief. Starke Evidenz sind fallbezogene Formulierungen wie Gangrän/Nekrose der Lunge, destruertes/destruiertes Lungenparenchym, carnifizierte Lunge/Hepatisation mit Parenchymzerstörung im Sinne einer destroyed lung. POSITIVBEISPIEL: Diagnose `Gangrän und Nekrose der Lunge` oder `Akute Hepatisation` mit destruiertem Parenchym als OP-Indikation -> \"1\". NEGATIVBEISPIEL: blosse lokale Parenchymverletzung bei Adhäsiolyse ohne destroyed-lung-/Gangrän-/Nekrose-Diagnose -> KEIN Eintrag. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Pneumothorax_Diagnose a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Pneumothorax (Diagnose)"@de ;
  med:csvHeader "Pneumothorax (Diagnose)" ;
  med:excelHeader "Pneumothorax" ;
  rdfs:comment "Ein Pneumothorax bezeichnet eine Luftansammlung im Pleuraspalt und ist eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Wichtig hierbei ist, dass der Pneumothorax der Grund für die Operation sein muss. Oft kann es nach einer Operation zu verbleibender Luft im Pleuraspalt kommen, die kein Grund für eine Intervention oder eine Operation ist. Dies ist hier explizit nicht gemeint, auch wenn die Diagnose im Arztbrief auftauchen kann. Liegt ein Pneumothorax vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Pleuraerguss a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Pleuraerguss"@de ;
  med:csvHeader "Pleuraerguss" ;
  med:excelHeader "Pleuraerguss" ;
  rdfs:comment "Ein Pleuraerguss bezeichnet eine Flüssigkeitsansammlung im Pleuraspalt und ist eine Diagnose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Wichtig hierbei ist, dass der Pleuraerguss der Grund für die Operation sein muss. Oft kann es nach einer Operation zu verbleibender Flüssigkeit im Pleuraspalt kommen, die kein Grund für eine Intervention oder eine Operation ist. Dies ist hier explizit nicht gemeint, auch wenn die Diagnose im Arztbrief auftauchen kann. Liegt ein Pleuraerguss vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:interstitielle_Lungenerkrankung a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "interstitielle Lungenerkrankung"@de ;
  med:csvHeader "interstitielle Lungenerkrankung" ;
  med:excelHeader "interstitielle Lungenerkrankung" ;
  rdfs:comment "Eine interstitielle Lungenerkrankung bezeichnet eine Lungengerüsterkrankung und ist eine Diagnose. Beispiele für eine interstitielle Lungenerkrankung sind z.B. COPD oder Lungenfibrose. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Liegt eine interstitielle Lungenerkrankung vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:Thoraxtrauma_Haematothorax_Rippenfraktur a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "Thoraxtrauma (Hämatothorax, Rippenfraktur)"@de ;
  med:csvHeader "Thoraxtrauma (Hämatothorax, Rippenfraktur)" ;
  med:excelHeader "Thoraxtrauma (Hämatothorax, Rippenfraktur) " ;
  rdfs:comment "Ein Thoraxtrauma bezeichnet alle Formen der Verletzungen, die nach Trauma im Thoraxbereich auftreten können und ist eine Diagnose. Häufige Beispiele sind der Hämatothorax (Blut im Thorax) oder die Rippenfraktur. Ersichtlich ist die Diagnose in der Regel aus dem OP-Bericht oder dem Arztbrief. Liegt ein Thoraxtrauma (Hämatothorax, Rippenfraktur) vor ist in die Spalte eine \"1\" einzutragen. Andernfalls erfolgt keine Eintragung. Es kann mehrere Diagnosen gleichzeitig geben."@de  ;
  med:valueKind "binary_checklist" .


med:sonst_Diagnose a owl:DatatypeProperty ;
  rdfs:domain med:Diagnosis ;
  rdfs:range xsd:string ;
  rdfs:label "sonst. (Diagnose)"@de ;
  med:csvHeader "sonst. (Diagnose)" ;
  med:excelHeader "sonst. " ;
  rdfs:comment "FREITEXT-FALLBACK fuer explizite Diagnosen, die kein kanonisches Diagnosefeld abdeckt. In einer Diagnose-/Indikationsliste deckt ein kanonisches Feld nur den passenden Listeneintrag ab; separate nicht-kanonische Listeneintraege muessen hier erhalten bleiben. Beispiel: `Pleuraempyem` -> Empyem_Diagnose, aber separater Eintrag `Fibrothorax rechts` -> `Fibrothorax`. Bei Adhaesions-/Verwachsungsdiagnosen nur den Kernbegriff ohne Seitenangabe ausgeben, z.B. `Lungenadhaesionen rechts` -> `Lungenadhaesionen`. Keine Paraphrase, nur kuerzeste fallbezogene Diagnosephrase. POSITIVBEISPIEL: `Hyperhidrosis manuum` / `Hyperhidrose manuum` ohne passendes kanonisches Feld -> hier eintragen (nicht weglassen). NEGATIVBEISPIELE: bereits kanonisch abgedeckte Diagnosen (NSCLC, Empyem, Destroyed Lung, Metastasen) NICHT zusaetzlich als Freitext hier wiederholen; eine blosse ICD-/Lokalisationstextzeile wie `Bösartige Neubildung: Oberlappen ...` nicht hier ablegen, wenn sie nur die kanonische Tumor-/Metastasenentscheidung paraphrasiert. Hämatothorax als Diagnose gehoert bei Trauma-/Verletzungskontext bevorzugt nach `Thoraxtrauma (Hämatothorax, Rippenfraktur)`, nicht als sonst.-Freitext, sofern das kanonische Feld greift."@de  ;
  med:valueKind "free_text_fallback" .


#################################################################
# Complication – Datatype Properties
#################################################################

med:Komplikation_j_n a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Komplikation (j/n)"@de ;
  med:csvHeader "Komplikation (j/n)" ;
  med:excelHeader "Komplikation (j/n)" ;
  rdfs:comment "Postoperative Komplikationen (Abweichung vom ueblichen Verlauf). DATENQUELLE: QM-Bogen oder Arztbrief – ohne diese ist das Feld oft nicht befuellbar. Zeitraum: OP-Tag bis Entlassung. Alle Komplikations-Untertypen (Fistel, Haematothorax, etc.) sind NUR relevant, wenn hier \"1\". `Komplikation (j/n)` darf NICHT aus allgemeinen Erklaerungen, Definitionen, Clavien/Dindo-Hintergrundwissen oder blossen Feldnamen abgeleitet werden; es braucht eine fallbezogene explizite Komplikationsangabe. Intraoperative technische Beobachtungen, isolierte unmittelbare Reventilations-/Umlagerungslecks oder eine blosse Intensivverlegung/Umintubation ohne explizite Komplikationswertung reichen nicht aus. Nicht ausreichend sind prophylaktische oder vorbeugende Formulierungen wie zur Vermeidung eines moeglichen Ereignisses, Blutungsprophylaxe, vorsorgliche Drainage-/Spuelsystemanlage oder die blosse Beschreibung intraoperativer Blutstillung, solange kein tatsaechlich eingetretenes postoperatives Ereignis benannt wird. Auch Formulierungen wie zur Vermeidung eines postoperativen Haematothorax oder blosse diffuse Sickerblutungen mit intraoperativer Blutstillung reichen dafuer NICHT aus. Eine blosse Problem- oder Indikationsbeschreibung fuer die aktuelle OP (z.B. unvollstaendige Drainagetherapie, Fibrothorax/Empyem-Stadium im Praeparationsbefund, Reoperationsindikation wegen Grunderkrankung) ist fuer dieses Feld ebenfalls NICHT ausreichend, solange kein zusaetzliches tatsaechlich eingetretenes postoperatives Komplikationsereignis des Falls explizit benannt wird. POSITIVBEISPIEL: `postoperativ trat eine behandlungsbeduerftige Komplikation auf` -> `1`. NEGATIVBEISPIEL: `zur Vermeidung eines Ereignisses wurde prophylaktisch drainiert` oder `Indikation zur Reoperation wegen Grunderkrankung` -> KEIN Eintrag. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Clavien_Dindo a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Clavien/Dindo"@de ;
  med:csvHeader "Clavien/Dindo" ;
  med:excelHeader "Clavien/Dindo" ;
  rdfs:comment "Clavien/Dindo: Klassifikation der Komplikationsschwere. BEDINGT: NUR wenn Komplikation = \"1\". Referenz: https://de.wikipedia.org/wiki/Clavien-Dindo-Klassifikation . Alle Grade erfassen."@de  ;
  med:valueKind "free_text" .


med:Kommentar a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Kommentar"@de ;
  med:csvHeader "Kommentar" ;
  med:excelHeader "Kommentar" ;
  rdfs:comment "Freitext zur Differenzierung: Bezieht sich die Clavien/Dindo-Komplikation auf den thoraxchirurgischen Eingriff? BEDINGT: NUR ausfuellen, wenn Clavien/Dindo befuellt ist UND der Fall selbst dazu eine konkrete Bemerkung enthaelt. Hier darf NUR kurze fallbezogene Freitextinformation stehen, keine Definition, keine Lehrbucherklaerung und keine Wiederholung der Feldbeschreibung. Isolierte unmittelbare Leckage-, Drainagefluss- oder Umintubationssaetze ohne explizite Komplikationsklassifikation sollen hier nicht als Kommentar eingetragen werden. Typisch wenn thoraxchirurgische OP nicht primaer war (z.B. Folge Oesophagusresektion, herzchirurgischer OP)."@de  ;
  med:valueKind "free_text_fallback" .


med:Fistel a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Fistel"@de ;
  med:csvHeader "Fistel" ;
  med:excelHeader "Fistel" ;
  rdfs:comment "Eine Fistel bezeichnet die Persistenz einer Luftleckage aus der Lunge über mehr als 7 Tage postoperativ und bezeichnet eine Komplikation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Fistel ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Haematothorax a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Hämatothorax"@de ;
  med:csvHeader "Hämatothorax" ;
  med:excelHeader "Hämatothorax" ;
  rdfs:comment "Ein Hämatothorax bezeichnet die Ansammlung von Blut im Pleuraspalt nach einer Operation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Hämatothorax ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es koennen mehrere Komplikationen gleichzeitig vorliegen. Nicht ausreichend sind prophylaktische Hinweise wie zur Vermeidung eines postoperativen Haematothorax, Blutungsneigung ohne bestaetigtes postoperatives Ereignis oder die blosse intraoperative Anlage zusaetzlicher Drainagen/Spuelsysteme; es braucht einen tatsaechlich eingetretenen postoperativen Haematothorax als Fallereignis. Eine prophylaktische Spuelung oder Drainageanlage zur Vermeidung dieses Ereignisses zaehlt nicht als eingetretener Haematothorax. Auch Formulierungen wie `Empyem Stadium II bis III`, diffuse Blutungsneigung oder eine zur Vorbeugung angelegte Spueldrainage sind fuer dieses Feld KEINE starke Evidenz, solange die Quelle keinen tatsaechlich eingetretenen postoperativen Haematothorax als Komplikation des Falls festhaelt. POSITIVBEISPIEL: `postoperativer Haematothorax diagnostiziert` -> `1`. NEGATIVBEISPIEL: `Spueldrainage zur Vermeidung eines Haematothorax angelegt` -> KEIN Eintrag."@de  ;
  med:valueKind "binary_checklist" .


med:Empyem_Komplikation a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Empyem (Komplikation)"@de ;
  med:csvHeader "Empyem (Komplikation)" ;
  med:excelHeader "Empyem" ;
  rdfs:comment "Ein Empyem bezeichnet die Ansammlung von Eiter nach einer Operation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Empyem ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Bronchusstumpf_Anastomoseninsuffizienz a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Bronchusstumpf-/Anastomoseninsuffizienz"@de ;
  med:csvHeader "Bronchusstumpf-/Anastomoseninsuffizienz" ;
  med:excelHeader "Bronchusstumpf-/Anastomoseninsuffizienz" ;
  rdfs:comment "Eine Bronchusstumpfinsuffizienz bezeichnet die Undichtigkeit einer Bronchusnaht nach einer Operation und ist eine Komplikation. Bei einer erweiterten Resektion bzw. Manschettenresektion kann auch die Bronchusanastomose undicht werden. Darüber hinaus können Gefäßanastomosen undicht werden. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Bronchusstumpf-/Anastomoseninsuffizienz ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Pneumothorax_Komplikation a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Pneumothorax (Komplikation)"@de ;
  med:csvHeader "Pneumothorax (Komplikation)" ;
  med:excelHeader "Pneumothorax" ;
  rdfs:comment "Pneumothorax als Komplikation: Luft im Pleuraspalt nach OP. NUR eintragen, wenn Drainage/Punktion oder Reoperation erforderlich war – nicht bloße Restschrägstellung. BEDINGT: NUR wenn Komplikation = \"1\". Ersichtlich aus QM-Bogen oder Arztbrief."@de  ;
  med:valueKind "binary_checklist" .


med:kardiovaskulaer a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "kardiovaskulär"@de ;
  med:csvHeader "kardiovaskulär" ;
  med:excelHeader "kardiovaskulär" ;
  rdfs:comment "Kardiovaskuläre Komplikationen nach einer Operation beinhalten das Auftreten von bspw. neuen Thrombosen, Embolien, Rhythmusstörungen, Ischämien, o.Ä. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von kardiovaskulären Komplikationen ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Pneumonie a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Pneumonie"@de ;
  med:csvHeader "Pneumonie" ;
  med:excelHeader "Pneumonie" ;
  rdfs:comment "Eine Pneumonie bezeichnet eine Infektion des Lungenparenchyms und ist eine Komplikation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Pneumonie ist eine \"1\" in die Spalte einzutragen. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Andernfalls erfolgt keine Eintragung. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:andere_nosokomiale_Infektionen a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "andere nosokomiale Infektionen"@de ;
  med:csvHeader "andere nosokomiale Infektionen" ;
  med:excelHeader "andere nosokomiale Infektionen " ;
  rdfs:comment "Nosokomiale Infektionen AUSSER Pneumonie, Wundheilungsstörung und Empyem – z.B. Harnwegsinfekte. BEDINGT: NUR wenn Komplikation = \"1\". Ersichtlich aus QM-Bogen oder Arztbrief. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:resp_Insuffizienz a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "resp. Insuffizienz"@de ;
  med:csvHeader "resp. Insuffizienz" ;
  med:excelHeader "resp. Insuffizienz" ;
  rdfs:comment "Die resp. (respiratorische) Insuffizienz bezeichnet ein Versagen des pulmonalen Gasaustausches unterschiedlicher Genese und ist eine Komplikation. Definiert wird das Vorhandensein der Komplikation in der Regel durch eine Reintubation. Andernfalls wird die Komplikation aus dem QM-Bogen oder dem Arztbrief ersichtlich. Bei Vorliegen von resp. Insuffizienz ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Niereninsuffizienz a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Niereninsuffizienz"@de ;
  med:csvHeader "Niereninsuffizienz" ;
  med:excelHeader "Niereninsuffizienz" ;
  rdfs:comment "Bei der Niereninsuffizienz (akuten Nierenschädigung) verschlechtert sich die Fähigkeit der Nieren, das Blut von Stoffwechselabbauprodukten zu reinigen, zunehmend schneller (im Verlauf von Tagen bis Wochen). Die Niereninsuffizienz ist eine Komplikation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Niereninsuffizienz ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Wundheilungsstoerung a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Wundheilungsstörung"@de ;
  med:csvHeader "Wundheilungsstörung" ;
  med:excelHeader "Wundheilungsstörung" ;
  rdfs:comment "Die Wundheilungsstörung ist eine Komplikation, die oftmals bei Wundinfektion auftritt und diese mit einschließt. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Wundheilungsstörung ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde. Es können mehrere Komplikationen gleichzeitig vorliegen."@de  ;
  med:valueKind "binary_checklist" .


med:Tod a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Tod"@de ;
  med:csvHeader "Tod" ;
  med:excelHeader "Tod" ;
  rdfs:comment "Der Tod eines Patienten ist eine Komplikation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Tod ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde."@de  ;
  med:valueKind "binary_checklist" .


med:Drainage_Punktion a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Drainage/Punktion"@de ;
  med:csvHeader "Drainage/Punktion" ;
  med:excelHeader "Drainage/Punktion" ;
  rdfs:comment "Eine Drainage/Punktion bezeichnet das offene oder bildgestützte Anlegen einer (meist) Thoraxdrainage zur Adressierung von bspw. Pleuraerguss, Pneumothorax oder Empyem. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Drainage/Punktion ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Wird mehrmals nach einer Primäroperation eine Drainage oder Punktion durchgeführt wird die Zeile dennoch nur mit \"1\" beantwortet. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde."@de  ;
  med:valueKind "binary_checklist" .


med:Reintubation a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Reintubation"@de ;
  med:csvHeader "Reintubation" ;
  med:excelHeader "Reintubation" ;
  rdfs:comment "Eine Reintubation bezeichnet die Notwendigkeit einer erneuten Intubation nach erfolgter Extubation nach der Primäroperation. Oft geschieht dies bei resp. Insuffizienz. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Reintubation ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Wird mehrmals nach einer Primäroperation reintubiert wird die Zeile dennoch nur mit \"1\" beantwortet. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde."@de  ;
  med:valueKind "binary_checklist" .


med:medikamentoese_Therapie a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "medikamentöse Therapie"@de ;
  med:csvHeader "medikamentöse Therapie" ;
  med:excelHeader "medikamentöse Therapie" ;
  rdfs:comment "Medikamentöse Therapie = Clavien-Dindo Stufe II (Medikamentengabe zur Komplikationsbehandlung). BEDINGT: NUR wenn Komplikation = \"1\". Referenz: https://de.wikipedia.org/wiki/Clavien-Dindo-Klassifikation . Ersichtlich aus QM-Bogen oder Arztbrief."@de  ;
  med:valueKind "binary_checklist" .


med:Transfusion a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Transfusion"@de ;
  med:csvHeader "Transfusion" ;
  med:excelHeader "Transfusion" ;
  rdfs:comment "Eine Transfusion bezieht sich auf die Verabreichung von Erythrozyten-, Thrombozytenkonzentraten oder Fresh Frozen Plasma im Verlauf nach einer Operation. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Transfusion ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Wird mehrmals nach einer Primäroperation transfundiert, wird die Zeile dennoch nur mit \"1\" beantwortet. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde."@de  ;
  med:valueKind "binary_checklist" .


med:Endoskopie a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Endoskopie"@de ;
  med:csvHeader "Endoskopie" ;
  med:excelHeader "Endoskopie" ;
  rdfs:comment "Endoskopie (Magen-/Darmspiegelung, ERCP, Bronchoskopie) NACH OP zur Komplikationsbehandlung. BEDINGT: NUR wenn Komplikation = \"1\". Ersichtlich aus QM-Bogen oder Arztbrief. Liegt vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:Reoperation a owl:DatatypeProperty ;
  rdfs:domain med:Complication ;
  rdfs:range xsd:string ;
  rdfs:label "Reoperation"@de ;
  med:csvHeader "Reoperation" ;
  med:excelHeader "Reoperation" ;
  rdfs:comment "Die Reoperation bezeichnet die Notwendigkeit nach erfolgter Primäroperation erneut unter Allgemeinnarkose zu operieren, um eine Komplikation zu beheben. Ersichtlich ist dies in der Regel aus dem QM-Bogen oder dem Arztbrief. Bei Vorliegen von Reoperation ist eine \"1\" in die Spalte einzutragen. Andernfalls erfolgt keine Eintragung. Wird mehrmals nach einer Primäroperation operiert, wird die Zeile dennoch nur mit \"1\" beantwortet. Es erfolgt nur eine Eintragung, wenn Komplikation mit \"1\" beantwortet wurde."@de  ;
  med:valueKind "binary_checklist" .


#################################################################
# PathologyOutcome – Datatype Properties
#################################################################

med:Stadium a owl:DatatypeProperty ;
  rdfs:domain med:PathologyOutcome ;
  rdfs:range xsd:string ;
  rdfs:label "Stadium"@de ;
  med:csvHeader "Stadium" ;
  med:excelHeader "Stadium" ;
  rdfs:comment "Stadium: UICC-Stadium (z.B. IIIA). BEDINGT: NUR wenn NSCLC, SCLC, NET, Thymom, Thymus-Ca, andere Mediastinaltumoren oder Mesotheliom = \"1\". DATENQUELLE: endgültiger Pathologie-/Histologiebefund. Referenz: aktuellste UICC zum OP-Zeitpunkt. WICHTIG: Hier ist nur ein oncologisches Tumorstadium gemeint. Andere Verwendungen von `Stadium`, insbesondere Empyem-/Fibrothorax-Stadien oder sonstige nicht-onkologische Stadien der Grunderkrankung bzw. OP-Indikation, duerfen fuer dieses Feld NICHT uebernommen werden. POSITIVBEISPIEL: `UICC IIIA` oder `pathologisches Stadium pT...` im finalen Tumorkontext -> uebernehmen. NEGATIVBEISPIEL: `Empyem Stadium II` oder `Fibrothorax Stadium III` -> NICHT uebernehmen."@de  ;
  med:valueKind "free_text" .


med:R0 a owl:DatatypeProperty ;
  rdfs:domain med:PathologyOutcome ;
  rdfs:range xsd:string ;
  rdfs:label "R0"@de ;
  med:csvHeader "R0" ;
  med:excelHeader "R0 " ;
  rdfs:comment "R0: Resektion im Gesunden (in sano). DATENQUELLE: endgültiger histologischer Befund. Intraoperative Schnellschnitt-/Frozen-Section-Aussagen oder andere provisorische Rueckmeldungen reichen allein nicht aus, solange sie nicht als endgueltiger histologischer Befund des Falls dokumentiert werden. Eine explizite Pathologie-Rueckmeldung wie `R0-Resektion bestaetigt` reicht als R0-Evidenz, sofern keine spaetere endgueltige Pathologie-/Histologieaussage widerspricht. NEGATIVBEISPIEL: blosse intraoperative/makroskopische Formulierung wie `tumorfreier Absetzungsrand von Bronchus und Parenchym` ohne endgueltigen Histologie-/R0-Befund -> KEIN Eintrag. Liegt R0 vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:R1 a owl:DatatypeProperty ;
  rdfs:domain med:PathologyOutcome ;
  rdfs:range xsd:string ;
  rdfs:label "R1"@de ;
  med:csvHeader "R1" ;
  med:excelHeader "R1" ;
  rdfs:comment "R1: mikroskopisch Tumorgewebe am Resektionsrand. DATENQUELLE: endgültiger histologischer Befund. Intraoperative Schnellschnitt-/Frozen-Section-Aussagen oder andere provisorische Rueckmeldungen reichen allein nicht aus, solange sie nicht als endgueltiger histologischer Befund des Falls dokumentiert werden. Liegt R1 vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .


med:R2 a owl:DatatypeProperty ;
  rdfs:domain med:PathologyOutcome ;
  rdfs:range xsd:string ;
  rdfs:label "R2"@de ;
  med:csvHeader "R2" ;
  med:excelHeader "R2" ;
  rdfs:comment "R2: makroskopisch Tumorgewebe am Resektionsrand. DATENQUELLE: endgültiger histologischer Befund. Intraoperative Schnellschnitt-/Frozen-Section-Aussagen oder andere provisorische Rueckmeldungen reichen allein nicht aus, solange sie nicht als endgueltiger histologischer Befund des Falls dokumentiert werden. Liegt R2 vor: \"1\", sonst keine Eintragung."@de  ;
  med:valueKind "binary_checklist" .
