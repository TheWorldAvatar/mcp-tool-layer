# Remote OpenAI-compatible endpoint (OpenRouter or Azure/OpenAI).
REMOTE_BASE_URL=https://openrouter.ai/api/v1
REMOTE_API_KEY=

# Optional overrides. Leave ROOT_DIR unset so the clone is discovered
# automatically from this repository (works on any machine).
# ROOT_DIR=
# CONFIGS_DIR=
# TWA_GENERATED_ARTIFACT_ROOT=generated/runs/<timestamp>_<tag>
# TWA_GENERATION_MODEL=kimi-k3
# Kimi K3 defaults to reasoning_effort=low. Override only if needed:
# TWA_REASONING_EFFORT=low
# TWA_GENERATION_TIMEOUT=1800
# TWA_DISABLE_GENERATION_TIMEOUT=0
# LLM_MAX_RETRIES=3
# TWA_LLM_SEED=42

# Optional. Licensed local CSD only — required to finish chemistry CBU
# (CIF fetch via the CCDC MCP). Prompt generation, extraction, KG, PubChem,
# OntoMed, and chemicals/steps/characterisation scores run without this.
# CSD_PYTHON_EXE=C:\Users\<you>\AppData\Local\anaconda3\envs\csd311\python.exe
# CSD_CONDA_ENV=csd311
